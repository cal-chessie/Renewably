# ============================================================================
# RENEWABLY CRM — Environment Variables Template
# ============================================================================
# Copy this file to .env.local for development or .env.production for prod.
# NEVER commit secrets to version control.
# ============================================================================

# ── Supabase (PostgreSQL) ──────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Public URL (for password reset redirects, OAuth, etc.) ──────────────────
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Postmark (Transactional Email) ─────────────────────────────────────────
POSTMARK_SERVER_TOKEN=your-postmark-token
POSTMARK_FROM_EMAIL=hello@renewably.ie
POSTMARK_WEBHOOK_SIGNATURE=
FROM_EMAIL=hello@renewably.ie

# ── Stripe (Payments) ──────────────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret
STRIPE_PRICE_STARTER=price_placeholder_starter
STRIPE_PRICE_PRO=price_placeholder_pro
STRIPE_PRICE_ENTERPRISE=price_placeholder_enterprise

# ── Redis (Rate Limiting & Caching) ───────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Anthropic (AI Assistant) ───────────────────────────────────────────────
ANTHROPIC_API_KEY=your-anthropic-key
AGENT_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-20250514
CLAUDE_MAX_TOKENS=4096

# ── Google (Calendar Sync + Drive) ────────────────────────────────────────
# Shared OAuth web-app creds. SERVER-ONLY secrets - never a NEXT_PUBLIC_ prefix.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# ENV-GATED Drive folders: src/lib/drive.ts create-or-gets a per-lead folder
# under this root and returns its link; the cockpit "Drive folder" action goes
# live only when CLIENT_ID + CLIENT_SECRET + this root are ALL set - otherwise
# it renders an honest "Drive not connected". This is the Drive file id of the
# parent folder (from its URL: drive.google.com/drive/folders/<THIS_ID>).
# Drive reuses the calendar OAuth connection; TODO(relay): confirm Drive scope
# on the OAuth consent screen (drive.file added in auth-url; accounts must
# re-authorise). SERVER-ONLY - never a NEXT_PUBLIC_ prefix.
GOOGLE_DRIVE_FOLDER_ID=

# ── Telegram (Two-way reporting bot for Cal) ───────────────────────────────
# Create a bot with @BotFather to get TELEGRAM_BOT_TOKEN.
# TELEGRAM_CHAT_ID is the chat the daily brief is sent to (message the bot, then
# read chat.id from https://api.telegram.org/bot<token>/getUpdates).
# Both are SERVER-ONLY secrets - never add a NEXT_PUBLIC_ prefix.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Secret token you set when registering the webhook (setWebhook secret_token).
# /api/telegram/webhook rejects any request whose X-Telegram-Bot-Api-Secret-Token
# header does not match this. Use a long random string. Without it the webhook
# no-ops as "not configured". See docs/TELEGRAM_SETUP.md.
TELEGRAM_WEBHOOK_SECRET=

# ── Cal.com (Demo booking) ─────────────────────────────────────────────────
# ENV-GATED: with no CALCOM_API_KEY, src/lib/calcom.ts create/fetch calls no-op
# with { ok:false, reason:'Cal.com not configured' } and never fake a booking.
# The webhook (/api/crm/calcom/webhook) is gated on CALCOM_WEBHOOK_SECRET: with
# no secret it cannot verify the caller and returns an honest not-configured
# state. All three are SERVER-ONLY secrets - never add a NEXT_PUBLIC_ prefix.
# TODO(relay): the v2 API + webhook shapes are built to Cal.com's documented v2
# spec but were NOT verified against a live account - confirm before go-live.
CALCOM_API_KEY=
# Shared secret you set when registering the Cal.com webhook. The route rejects
# any request whose HMAC signature (X-Cal-Signature-256) does not match.
CALCOM_WEBHOOK_SECRET=
# Public scheduling page for the booking link, e.g.
# https://cal.com/renewably/relay-demo (self-hosted URL also allowed).
CALCOM_BOOKING_URL=
# Numeric event type id used by the programmatic createBooking() helper.
CALCOM_EVENT_TYPE_ID=
# Optional overrides (defaults: https://api.cal.com/v2 and version 2024-08-13).
CALCOM_API_BASE_URL=
CALCOM_API_VERSION=

# ── Analytics (optional — tracking pixels) ─────────────────────────────────
GA_MEASUREMENT_ID=
GTM_CONTAINER_ID=
FB_PIXEL_ID=
IG_BUSINESS_ACCOUNT_ID=

# ── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=info
